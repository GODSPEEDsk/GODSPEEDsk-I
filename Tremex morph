local function desc(i)
 local t={class=i.ClassName}
 if i:IsA("Accessory")then
  t.name=i.Name
  local h=i:FindFirstChild("Handle")
  if h then
   t.handleClass=h.ClassName
   t.handleSize=tostring(h.Size)
   local m=h:FindFirstChildOfClass("SpecialMesh") or h:FindFirstChildOfClass("Mesh")
   if m then
    t.meshClass=m.ClassName
    t.meshId=tostring(m.MeshId or m.Mesh or "")
    t.textureId=tostring(m.TextureId or "")
    if m:IsA("SpecialMesh")then t.meshScale=tostring(m.Scale or Vector3.new()) end
   end
   local decs={}
   for _,c in ipairs(h:GetChildren())do
    if c:IsA("Decal") or c:IsA("Texture")then table.insert(decs,tostring(c.Texture))end
   end
   table.sort(decs)
   t.decals=decs
  end
  local atts={}
  for _,c in ipairs(i:GetDescendants())do if c:IsA("Attachment")then table.insert(atts,c.Name)end end
  table.sort(atts)
  t.attachments=atts
 elseif i:IsA("CharacterMesh")then
  t.meshId=tostring(i.MeshId or "")
  t.bodyPart=tostring(i.BodyPart or "")
 elseif i:IsA("SpecialMesh")then
  t.meshId=tostring(i.MeshId or "")
  t.meshType=tostring(i.MeshType and i.MeshType.Name or "")
  t.textureId=tostring(i.TextureId or "")
  t.scale=tostring(i.Scale or Vector3.new())
 end
 return t
end

local function eq(a,b)
 if type(a)~=type(b)then return false end
 if type(a)~="table"then return tostring(a)==tostring(b) end
 for k,v in pairs(a)do
  if b[k]==nil then return false end
  if type(v)=="table"then if not eq(v,b[k])then return false end
  else if tostring(v)~=tostring(b[k])then return false end
  end
 end
 for k in pairs(b)do if a[k]==nil then return false end end
 return true
end

local function cap()
 local c=pl.Character
 if not c then return end
 local l={}
 for _,i in ipairs(c:GetChildren())do
  if i:IsA("Accessory")or i:IsA("CharacterMesh")or i:IsA("SpecialMesh")then table.insert(l,desc(i))end
 end
 d=l
end

local function matches(i)
 if not d then return false end
 local dd=desc(i)
 for _,w in ipairs(d)do if eq(dd,w)then return true end end
 return false
end

local function clean(c)
 local ch=c or pl.Character
 if not ch then return end
 for _,i in ipairs(ch:GetChildren())do
  if i:IsA("Accessory")or i:IsA("CharacterMesh")or i:IsA("SpecialMesh")then
   if not matches(i)then i:Destroy() end
  end
 end
end

